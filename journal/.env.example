# Bitget API — use the same names as official Bitget MCP
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
# Legacy aliases still work: BITGET_API_SECRET, BITGET_API_PASSPHRASE

# Optional: force demo even if keys exist
JOURNAL_FORCE_DEMO=0

# Planned risk per trade used for R multiples (legacy / review fallback)
DEFAULT_RISK_USD=25

# Optional: richer Korean coaching text
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required on Vercel so the public URL is not open
SITE_PASSWORD=

# TradingView webhook (Alert → Webhook URL)
# POST https://YOUR_DOMAIN/api/tv-webhook
TV_WEBHOOK_SECRET=

# Bitget execution bridge (TV → LEDGER → USDT-FUTURES)
# off = alerts only | dry_run = preview order | live = placeOrder
BITGET_EXECUTE=off
BITGET_SYMBOL_ALLOWLIST=BTCUSDT

# Sizing: $100 account = 1/100 of the $10k TV Fixed packs
# Long:  SL $500 / risk $500 / TP $1100 → qty 1
# Short: SL $1000 / risk $500 / TP $2100 → qty 0.5
# Live: 5% of $100 → cash risk $5; alert sl/tp set price distances.
# TARGET_RISK/REWARD 0 = derive from SL_PCT / TP_PCT × sized base.
BITGET_MARGIN_USDT=0
BITGET_ACCOUNT_USDT=100
BITGET_SIZE_MIN=100
BITGET_SIZE_STEP=100
BITGET_SL_PCT=5
BITGET_TP_PCT=11
BITGET_TARGET_RISK_USD=0
BITGET_TARGET_REWARD_USD=0
BITGET_TARGET_SL_USD_LONG=500
BITGET_TARGET_TP_USD_LONG=1100
BITGET_TARGET_SL_USD_SHORT=1000
BITGET_TARGET_TP_USD_SHORT=2100
# Legacy shared fallbacks (used only if side-specific unset)
BITGET_TARGET_SL_USD=500
BITGET_TARGET_TP_USD=1100
BITGET_LEVERAGE=10
BITGET_LEVERAGE_MIN=1
BITGET_LEVERAGE_MAX=20
BITGET_RISK_USD=0
BITGET_MAX_QTY=5
BITGET_ALLOW_PYRAMID=0

# Telegram push for SETUP_ARMED / ENTRY_READY
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord channel webhook (Server Settings → Integrations → Webhooks)
# https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_URL=

# Cloudflare R2 for durable screenshots + journal JSON
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL prefix for screenshots (r2.dev) — end without /
R2_PUBLIC_BASE_URL=
# Optional private bucket for journal/reviews (recommended if R2_BUCKET is public)
R2_DATA_BUCKET=
