# Bitget API — use the same names as official Bitget MCP
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
# Legacy aliases still work: BITGET_API_SECRET, BITGET_API_PASSPHRASE

# Optional: force demo even if keys exist
JOURNAL_FORCE_DEMO=0

# Planned risk per trade used for R multiples (legacy / review fallback)
DEFAULT_RISK_USD=25

# Optional: richer Korean coaching text
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required on Vercel so the public URL is not open
SITE_PASSWORD=

# TradingView webhook (Alert → Webhook URL)
# POST https://YOUR_DOMAIN/api/tv-webhook
TV_WEBHOOK_SECRET=

# Telegram push for SETUP_ARMED / ENTRY_READY
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare R2 for durable screenshots (optional; falls back to inline)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL prefix after enabling public access / custom domain
R2_PUBLIC_BASE_URL=
