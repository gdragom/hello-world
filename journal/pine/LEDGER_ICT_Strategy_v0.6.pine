//@version=5
// LEDGER ICT 1H Strategy v0.8.8
// Dual. Pace bump on C/D. Fib = Wait. Exit SL+2R.

strategy("LEDGER ICT 1H Strategy v0.8.8", overlay=true,
     max_boxes_count=50, max_lines_count=100, max_labels_count=150,
     pyramiding=0, initial_capital=10000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.percent, commission_value=0.04,
     process_orders_on_close=true, calc_on_every_tick=false)

grpAb = "A/B presets"
preset = input.string("C · Frequency", "Preset", options=["E · Consistent", "A · Quality", "B · Balanced", "C · Frequency", "D · Aggressive", "Custom (manual)"], group=grpAb,
     tooltip="C = pace 12·1.0ATR cool2. D denser. E/A = 14·1.2. Fib Wait. Exit SL+2R.")

grpWin = "Backtest window"
useDateWindow = input.bool(true, "Limit entries to date window", group=grpWin,
     tooltip="ON by default (recent ~2y).")
windowFrom = input.time(timestamp("2024-09-01T00:00:00"), "Window from", group=grpWin)
windowTo = input.time(timestamp("2026-09-08T23:59:59"), "Window to", group=grpWin)

grpBias = "Daily bias (Custom / always: doji %)"
dojiBodyPct = input.float(10.0, "Doji body ≤ % of range", minval=1.0, maxval=30.0, step=0.5, group=grpBias)
i_biasFilter = input.string("Block opposite", "Bias filter (longs)", options=["Off", "Block opposite", "Aligned only"], group=grpBias)
i_shortFilter = input.string("No shorts on bull day", "Short filter", options=["Match long bias", "Aligned only", "No shorts on bull day", "Long only"], group=grpBias)

grpSw = "Structure (Custom)"
i_swingLen = input.int(12, "Swing pivot length", minval=3, maxval=30, group=grpSw,
     tooltip="Pace default 12. Quality presets use 14. Larger = fewer SH/SL.")
i_minSwingAtr = input.float(1.0, "Min swing size (× ATR)", minval=0.0, step=0.1, group=grpSw,
     tooltip="Pace default 1.0. Raise toward 1.2 to cut micro swings.")
atrLen = input.int(14, "ATR length", minval=5, maxval=50, group=grpSw)
requireBody = input.bool(true, "BOS/MSS with candle BODY", group=grpSw)
i_fibMode = input.string("Wait post-swing", "Fib timing", options=["Wait post-swing", "Immediate on BOS"], group=grpSw,
     tooltip="Wait = Fib from confirmed SH→prior SL (or SL→prior SH). Cuts false Fibs.")

grpEnt = "1H entry (Custom)"
i_entryMode = input.string("Zone only", "Entry mode", options=["Zone + FVG/OB", "FVG/OB or deep zone", "Zone only"], group=grpEnt)
useFvg = input.bool(true, "Use FVG", group=grpEnt)
useOb = input.bool(true, "Use OB", group=grpEnt)
zoneKeep = input.int(80, "Keep virgin FVG/OB (bars)", minval=20, maxval=200, group=grpEnt)
needEither = input.bool(true, "FVG OR OB (off = both)", group=grpEnt)
maxZonesIn = input.int(12, "Max virgin zones kept", minval=4, maxval=30, group=grpEnt)
i_reenterSameFib = input.bool(true, "Re-enter after stop/TP (same Fib)", group=grpEnt)
i_entryCooldown = input.int(2, "Re-entry cooldown (bars)", minval=0, maxval=48, group=grpEnt)
i_postStopCooldown = input.int(2, "Post-stop ban (bars)", minval=0, maxval=72, group=grpEnt)
i_lockFibOnStop = input.bool(true, "Lock same Fib after stop", group=grpEnt)
minConf = input.int(0, "Min confidence to enter", minval=0, maxval=100, group=grpEnt)

grpRisk = "Strategy risk / exits"
riskPct = input.float(1.0, "Risk % of equity", minval=0.1, maxval=5.0, step=0.1, group=grpRisk)
i_rrMult = input.float(2.0, "Take profit (R)", minval=0.5, maxval=10.0, step=0.5, group=grpRisk)
i_slMode = input.string("Signal zone", "Stop mode", options=["Fib extreme", "Signal zone", "ATR × fallback", "Fixed USD"], group=grpRisk,
     tooltip="C/D default Signal zone. A/B/E = Fib extreme.")
fallbackAtrSl = input.float(1.5, "ATR SL mult (fallback)", minval=0.5, maxval=5.0, step=0.1, group=grpRisk)
fixedDollarSl = input.float(500.0, "Fixed SL distance (USD)", minval=50.0, maxval=5000.0, step=50.0, group=grpRisk)
i_minHoldBars = input.int(0, "Min hold before SL (bars)", minval=0, maxval=24, group=grpRisk)
i_maxHoldBars = input.int(0, "Max hold (bars, 0=off)", minval=0, maxval=168, group=grpRisk)
i_exitOppStruct = input.bool(false, "Exit on opposite BOS/MSS", group=grpRisk)
i_useBe = input.bool(false, "Move SL to BE after MFE ≥ R", group=grpRisk)
i_beTriggerR = input.float(1.0, "BE trigger (R)", minval=0.5, maxval=3.0, step=0.1, group=grpRisk)

// ── Resolve preset → effective knobs ────────────────────────────────
useCustom = preset == "Custom (manual)"
isE = preset == "E · Consistent"
isA = preset == "A · Quality"
isB = preset == "B · Balanced"
isC = preset == "C · Frequency"
isD = preset == "D · Aggressive"

biasFilter = useCustom ? i_biasFilter : isE or isA or isB ? "Aligned only" : isD ? "Off" : "Block opposite"
shortFilter = useCustom ? i_shortFilter : isE or isA or isB ? "Aligned only" : isD ? "Match long bias" : "No shorts on bull day"
swingLen = useCustom ? i_swingLen : isE or isA ? 14 : isD ? 10 : 12
minSwingAtr = useCustom ? i_minSwingAtr : isE or isA ? 1.2 : isD ? 0.8 : 1.0
fibMode = useCustom ? i_fibMode : "Wait post-swing"
entryMode = useCustom ? i_entryMode : (isE or isA or isB) ? "Zone + FVG/OB" : "Zone only"
reenterSameFib = useCustom ? i_reenterSameFib : isC or isD
entryCooldown = useCustom ? i_entryCooldown : isE ? 10 : isA ? 10 : isB ? 8 : isC ? 2 : 2
postStopCooldown = useCustom ? i_postStopCooldown : isE ? 12 : isA ? 12 : isB ? 10 : isC ? 2 : 3
lockFibOnStop = useCustom ? i_lockFibOnStop : not isD
rrMult = useCustom ? i_rrMult : isA ? 2.5 : 2.0
slMode = useCustom ? i_slMode : isC or isD ? "Signal zone" : "Fib extreme"
minHoldBars = useCustom ? i_minHoldBars : 0
maxHoldBars = useCustom ? i_maxHoldBars : 0
exitOppStruct = useCustom ? i_exitOppStruct : false
useBe = useCustom ? i_useBe : false
beTriggerR = useCustom ? i_beTriggerR : 1.0
presetTag = isE ? "E" : isA ? "A" : isB ? "B" : isC ? "C" : isD ? "D" : "Custom"
inDateWindow = not useDateWindow or (time >= windowFrom and time <= windowTo)
grpVis = "Display"
cleanMode = input.bool(true, "Clean mode", group=grpVis)
showSwings = input.bool(true, "Show swing marks", group=grpVis)
showFibExtremes = input.bool(false, "Show Fib 0 & 1 lines", group=grpVis,
     tooltip="Off by default. Yellow 0.5 = IRL. Green/red extremes clutter the chart.")
irlBars = input.int(60, "Keep fib/IRL (bars)", minval=20, group=grpVis)
highlightNow = input.bool(true, "NOW badge", group=grpVis)

grpAlert = "LEDGER webhook"
alertSecret = input.string("ledger-local-test-secret-7kQp2mN9", "TV_WEBHOOK_SECRET", group=grpAlert)
symbolOverride = input.string("", "Symbol override", group=grpAlert)
alertOnBos = input.bool(false, "Also alert on BOS (structure only)", group=grpAlert)

// ── Daily bias: build D from this chart's 1H bars; seal only on day change ──
// Matches TV Daily pane for same symbol (crypto D ≈ UTC 00:00 = HKT 08:00).
// Forming day stays in cur*; bias reads sealed y* (yesterday) vs b* (day before).
var float curO = na
var float curH = na
var float curL = na
var float curC = na
var float yO = na
var float yH = na
var float yL = na
var float yC = na
var float bH = na
var float bL = na

newDay = timeframe.change("D")
if newDay
    // First bar of new day: cur* still holds the completed previous day
    bH := yH
    bL := yL
    yO := curO
    yH := curH
    yL := curL
    yC := curC
    curO := open
    curH := high
    curL := low
    curC := close
else
    if na(curO)
        curO := open
        curH := high
        curL := low
        curC := close
    else
        curH := math.max(curH, high)
        curL := math.min(curL, low)
        curC := close

dO1 = yO
dH1 = yH
dL1 = yL
dC1 = yC
dH2 = bH
dL2 = bL

dRange1 = dH1 - dL1
isDojiD = not na(dO1) and not na(dC1) and dRange1 > 0 and (math.abs(dC1 - dO1) / dRange1 * 100.0) <= dojiBodyPct
isBullD = not na(dO1) and not na(dC1) and dC1 > dO1
isBearD = not na(dO1) and not na(dC1) and dC1 < dO1

// B: PDL/PDH of day-before-yesterday swept by yesterday, close back across that level
pdlSweep = not na(dL1) and not na(dL2) and not na(dC1) and dL1 < dL2 and dC1 > dL2
pdhSweep = not na(dH1) and not na(dH2) and not na(dC1) and dH1 > dH2 and dC1 < dH2

// biasDir: 1 long, -1 short, 0 uncertain
// biasQ: 2 sweep-confirmed, 1 color-only, 0 uncertain/doji
biasDir = 0
biasQ = 0
biasTxt = "UNCERTAIN"

if na(dC1) or na(dL2)
    biasDir := 0
    biasQ := 0
    biasTxt := "BIAS n/a"
else if pdlSweep and pdhSweep
    biasDir := 0
    biasQ := 0
    biasTxt := "UNCERTAIN (dual)"
else if pdlSweep
    // PDL sweep: green = LONG confirmed; red = UNCERTAIN
    if isDojiD
        biasDir := 0
        biasQ := 0
        biasTxt := "UNCERTAIN (PDL doji)"
    else if isBullD
        biasDir := 1
        biasQ := 2
        biasTxt := "LONG (PDL sweep)"
    else
        biasDir := 0
        biasQ := 0
        biasTxt := "UNCERTAIN (PDL+red)"
else if pdhSweep
    // PDH sweep mirror: red = SHORT confirmed; green = UNCERTAIN
    if isDojiD
        biasDir := 0
        biasQ := 0
        biasTxt := "UNCERTAIN (PDH doji)"
    else if isBearD
        biasDir := -1
        biasQ := 2
        biasTxt := "SHORT (PDH sweep)"
    else
        biasDir := 0
        biasQ := 0
        biasTxt := "UNCERTAIN (PDH+green)"
else
    if isDojiD
        biasDir := 0
        biasQ := 0
        biasTxt := "UNCERTAIN (doji)"
    else if isBullD
        biasDir := 1
        biasQ := 1
        biasTxt := "LONG (prior green)"
    else if isBearD
        biasDir := -1
        biasQ := 1
        biasTxt := "SHORT (prior red)"
    else
        biasDir := 0
        biasQ := 0
        biasTxt := "UNCERTAIN"

// Confidence 0–100 for an ENT print (indication only — never blocks)
f_entry_conf(isLong, hitFvg, hitOb) =>
    score = 45
    if hitFvg
        score += 15
    if hitOb
        score += 15
    align = isLong ? biasDir == 1 : biasDir == -1
    opposite = isLong ? biasDir == -1 : biasDir == 1
    if align and biasQ == 2
        score += 25
    else if align and biasQ == 1
        score += 15
    else if opposite
        score -= 25
    else
        score -= 12
    if isDojiD
        score -= 8
    math.max(0, math.min(100, score))

f_conf_tag(score) =>
    score >= 75 ? "HIGH" : score >= 55 ? "MID" : "LOW"

atr = ta.atr(atrLen)
minSwingDist = minSwingAtr <= 0 ? 0.0 : atr * minSwingAtr

// ── Swings (size-filtered) ──────────────────────────────────────────
rawPh = ta.pivothigh(high, swingLen, swingLen)
rawPl = ta.pivotlow(low, swingLen, swingLen)

var float lastSH = na
var float lastSL = na
var int   lastShBar = na
var int   lastSlBar = na
var int   lastBreakSide = 0

// Pending SH/SL rays: grow until body break, then hard-stop (no extend.right)
var line  pendShLn = na
var line  pendSlLn = na
var bool  pendShLive = false
var bool  pendSlLive = false

ph = float(na)
pl = float(na)

if not na(rawPh)
    acceptSh = minSwingDist <= 0 or na(lastSL) or (rawPh - lastSL) >= minSwingDist
    if acceptSh
        ph := rawPh
        lastSH := rawPh
        lastShBar := bar_index - swingLen
        if not na(pendShLn)
            line.delete(pendShLn)
        pendShLn := line.new(lastShBar, lastSH, bar_index, lastSH,
             color=color.new(#e8a838, 0), style=line.style_dotted, width=1, extend=extend.none)
        pendShLive := true

if not na(rawPl)
    acceptSl = minSwingDist <= 0 or na(lastSH) or (lastSH - rawPl) >= minSwingDist
    if acceptSl
        pl := rawPl
        lastSL := rawPl
        lastSlBar := bar_index - swingLen
        if not na(pendSlLn)
            line.delete(pendSlLn)
        pendSlLn := line.new(lastSlBar, lastSL, bar_index, lastSL,
             color=color.new(#3dba7e, 0), style=line.style_dotted, width=1, extend=extend.none)
        pendSlLive := true

plotshape(showSwings and not na(ph), title="SH", style=shape.triangledown, location=location.abovebar,
     color=color.new(#e8a838, 20), size=size.tiny, offset=-swingLen)
plotshape(showSwings and not na(pl), title="SL", style=shape.triangleup, location=location.belowbar,
     color=color.new(#3dba7e, 20), size=size.tiny, offset=-swingLen)

// ── Bull state ──────────────────────────────────────────────────────
var bool  bBos = false
var int   bBosBar = na
var float bLevel = na
var float bPriorSL = na
var bool  bFibOn = false
var float bFibHi = na
var float bFibLo = na
var float bEq = na
var int   bFibBar = na
var bool  bEntered = false
var bool  bIsMss = false
var box   bIrl = na
var box   bFvgBox = na
var box   bObBox = na
var line  bBosLine = na
var label bSwingLbl = na
var label bBreakLbl = na
var label bFibLbl = na

// ── Bear state ──────────────────────────────────────────────────────
var bool  sBos = false
var int   sBosBar = na
var float sLevel = na
var float sPriorSH = na
var bool  sFibOn = false
var float sFibHi = na
var float sFibLo = na
var float sEq = na
var int   sFibBar = na
var bool  sEntered = false
var bool  sIsMss = false
var box   sIrl = na
var box   sFvgBox = na
var box   sObBox = na
var line  sBosLine = na
var label sSwingLbl = na
var label sBreakLbl = na
var label sFibLbl = na

var label nowBadge = na
var label[] entLHist = array.new_label()
var label[] entSHist = array.new_label()
maxEntHist = 30

f_push_ent(hist, lbl) =>
    array.push(hist, lbl)
    if array.size(hist) > maxEntHist
        old = array.shift(hist)
        if not na(old)
            label.delete(old)

// Helpers may only delete / mutate drawing objects passed in — never := globals
f_del_box(b) =>
    if not na(b)
        box.delete(b)

f_del_lab(l) =>
    if not na(l)
        label.delete(l)

// Retire structure: dotted only — never stretch x2 past the break bar
f_retire_struct(ln) =>
    if not na(ln)
        line.set_style(ln, line.style_dotted)
        line.set_extend(ln, extend.none)
        line.set_width(ln, 1)

// Snap pending SH/SL ray to this bar (end of level). Returns false if no live line.
f_snap_pending(ln, live) =>
    ok = live and not na(ln)
    if ok
        line.set_x2(ln, bar_index)
        line.set_extend(ln, extend.none)
    ok

// Promote snapped pending → live BOS/MSS look + tags
f_promote_struct(ln, swingBar, lvl, breakBar, isBull, isMss) =>
    col = isBull ? color.new(#3dba7e, 0) : color.new(#d4543c, 0)
    tag = isMss ? (isBull ? "MSS ↑" : "MSS ↓") : (isBull ? "BOS ↑" : "BOS ↓")
    if not na(ln)
        line.set_color(ln, col)
        line.set_style(ln, line.style_solid)
        line.set_width(ln, 2)
        line.set_extend(ln, extend.none)
        line.set_x2(ln, breakBar)
    x1 = na(swingBar) ? breakBar - 1 : swingBar
    swingTag = isBull ? "SH" : "SL"
    swingLbl = label.new(x1, lvl, swingTag,
         style=isBull ? label.style_label_down : label.style_label_up,
         color=color.new(col, 25), textcolor=color.white, size=size.normal)
    breakY = isBull ? math.max(high, lvl) : math.min(low, lvl)
    breakLbl = label.new(breakBar, breakY, tag,
         style=isBull ? label.style_label_down : label.style_label_up,
         color=color.new(col, 10), textcolor=color.white, size=size.normal)
    [swingLbl, breakLbl]

// Fallback if pending line missing (e.g. mid-load): fixed swing→break segment
f_new_struct_line(swingBar, lvl, breakBar, isBull, isMss) =>
    col = isBull ? color.new(#3dba7e, 0) : color.new(#d4543c, 0)
    tag = isMss ? (isBull ? "MSS ↑" : "MSS ↓") : (isBull ? "BOS ↑" : "BOS ↓")
    x1 = na(swingBar) ? breakBar - 1 : swingBar
    ln = line.new(x1, lvl, breakBar, lvl,
         color=col, style=line.style_solid, width=2, extend=extend.none)
    swingTag = isBull ? "SH" : "SL"
    swingLbl = label.new(x1, lvl, swingTag,
         style=isBull ? label.style_label_down : label.style_label_up,
         color=color.new(col, 25), textcolor=color.white, size=size.normal)
    breakY = isBull ? math.max(high, lvl) : math.min(low, lvl)
    breakLbl = label.new(breakBar, breakY, tag,
         style=isBull ? label.style_label_down : label.style_label_up,
         color=color.new(col, 10), textcolor=color.white, size=size.normal)
    [ln, swingLbl, breakLbl]

killBull = (bFibOn and not na(bFibBar) and bar_index - bFibBar > irlBars) or (bFibOn and not na(bFibLo) and close < bFibLo) or (bBos and not bFibOn and not na(bLevel) and close < bLevel)
killBear = (sFibOn and not na(sFibBar) and bar_index - sFibBar > irlBars) or (sFibOn and not na(sFibHi) and close > sFibHi) or (sBos and not sFibOn and not na(sLevel) and close > sLevel)

if killBull
    f_retire_struct(bBosLine)
    bBosLine := na
    bBos := false
    bFibOn := false
    bEntered := false
    bFibHi := na
    bFibLo := na
    bEq := na
    f_del_box(bIrl)
    f_del_box(bFvgBox)
    f_del_box(bObBox)
    f_del_lab(bFibLbl)
    bIrl := na
    bFvgBox := na
    bObBox := na
    bFibLbl := na
    // keep ENT L history labels
    // keep bSwingLbl / bBreakLbl on chart (history)

if killBear
    f_retire_struct(sBosLine)
    sBosLine := na
    sBos := false
    sFibOn := false
    sEntered := false
    sFibHi := na
    sFibLo := na
    sEq := na
    f_del_box(sIrl)
    f_del_box(sFvgBox)
    f_del_box(sObBox)
    f_del_lab(sFibLbl)
    sIrl := na
    sFvgBox := na
    sObBox := na
    sFibLbl := na
    // keep ENT S history labels
    // keep sSwingLbl / sBreakLbl on chart (history)

// ── 1) Bull BOS/MSS — pending SH ray ends on body break ─────────────
bullBodyTop = math.max(open, close)
bullBreak = not na(lastSH) and close > lastSH and (not requireBody or bullBodyTop > lastSH)
bullBosNow = false

if bullBreak and pendShLive
    f_snap_pending(pendShLn, true)
    pendShLive := false

if bullBreak and not bBos and not bFibOn
    // kill opposite bear (inline)
    f_retire_struct(sBosLine)
    sBosLine := na
    sBos := false
    sFibOn := false
    sEntered := false
    sFibHi := na
    sFibLo := na
    sEq := na
    f_del_box(sIrl)
    f_del_box(sFvgBox)
    f_del_box(sObBox)
    f_del_lab(sFibLbl)
    sIrl := na
    sFvgBox := na
    sObBox := na
    sFibLbl := na

    bIsMss := lastBreakSide == -1
    lastBreakSide := 1
    bBos := true
    bBosBar := bar_index
    bLevel := lastSH
    bPriorSL := lastSL
    bFibOn := false
    bEntered := false
    bFibHi := na
    bFibLo := na
    bEq := na
    f_del_box(bIrl)
    f_del_box(bFvgBox)
    f_del_box(bObBox)
    f_del_lab(bFibLbl)
    bIrl := na
    bFvgBox := na
    bObBox := na
    bFibLbl := na
    f_retire_struct(bBosLine)
    f_del_lab(bSwingLbl)
    f_del_lab(bBreakLbl)
    if not na(pendShLn)
        [bSw, bBr] = f_promote_struct(pendShLn, lastShBar, lastSH, bar_index, true, bIsMss)
        bBosLine := pendShLn
        bSwingLbl := bSw
        bBreakLbl := bBr
        pendShLn := na
    else
        [bLn, bSw, bBr] = f_new_struct_line(lastShBar, lastSH, bar_index, true, bIsMss)
        bBosLine := bLn
        bSwingLbl := bSw
        bBreakLbl := bBr
    bullBosNow := true
else if bullBreak and not na(pendShLn)
    // Broke SH while another plan is active — stop ray, keep short stub
    line.set_color(pendShLn, color.new(#3dba7e, 55))
    line.set_style(pendShLn, line.style_dotted)
    line.set_width(pendShLn, 1)
    line.set_extend(pendShLn, extend.none)
    line.set_x2(pendShLn, bar_index)
    pendShLn := na
    pendShLive := false

// ── 2) Fib: immediate on BOS and/or wait for post-BOS swing ──────────
bullFibNow = false

f_open_bull_fib(hi, lo, xBar) =>
    ok = not na(hi) and not na(lo) and hi > lo
    ok

if fibMode == "Immediate on BOS" and bullBosNow
    fibHiImm = math.max(high, bLevel)
    fibLoImm = not na(bPriorSL) ? bPriorSL : lastSL
    if f_open_bull_fib(fibHiImm, fibLoImm, bar_index)
        bFibHi := fibHiImm
        bFibLo := fibLoImm
        bEq := bFibLo + (bFibHi - bFibLo) * 0.5
        bFibOn := true
        bFibBar := bar_index
        bEntered := false
        bBos := false
        f_retire_struct(bBosLine)
        bBosLine := na
        f_del_box(bIrl)
        f_del_lab(bFibLbl)
        bIrl := box.new(bar_index, bEq, bar_index + irlBars, bFibLo,
             bgcolor=color.new(#1faa6e, 72), border_color=color.new(#f0c040, 0), border_width=3,
             border_style=line.style_dashed)
        bFibLbl := label.new(bar_index, bEq, "FIB ≤0.5 IRL",
             style=label.style_label_down, color=color.new(#f0c040, 0), textcolor=color.black, size=size.normal)
        bullFibNow := true

if bBos and not bFibOn and not na(ph)
    shBar = bar_index - swingLen
    if not na(bBosBar) and shBar > bBosBar
        fibLo = not na(lastSL) ? lastSL : bPriorSL
        if not na(fibLo) and ph > fibLo
            bFibHi := ph
            bFibLo := fibLo
            bEq := bFibLo + (bFibHi - bFibLo) * 0.5
            bFibOn := true
            bFibBar := bar_index
            bEntered := false
            bBos := false
            f_retire_struct(bBosLine)
            bBosLine := na
            f_del_box(bIrl)
            f_del_lab(bFibLbl)
            bIrl := box.new(bar_index - swingLen, bEq, bar_index + irlBars, bFibLo,
                 bgcolor=color.new(#1faa6e, 72), border_color=color.new(#f0c040, 0), border_width=3,
                 border_style=line.style_dashed)
            bFibLbl := label.new(bar_index - swingLen, bEq, "FIB ≤0.5 IRL",
                 style=label.style_label_down, color=color.new(#f0c040, 0), textcolor=color.black, size=size.normal)
            bullFibNow := true

// Upgrade immediate fib if a higher post-BOS SH appears
if bFibOn and fibMode == "Immediate on BOS" and not na(ph) and not na(bFibBar) and (bar_index - swingLen) > bFibBar and ph > bFibHi and not na(bFibLo) and ph > bFibLo
    bFibHi := ph
    bEq := bFibLo + (bFibHi - bFibLo) * 0.5
    if not na(bIrl)
        box.set_top(bIrl, bEq)
    if not na(bFibLbl)
        label.set_y(bFibLbl, bEq)
        label.set_x(bFibLbl, bar_index - swingLen)
// ── Bear BOS/MSS — pending SL ray ends on body break ────────────────
bearBodyBot = math.min(open, close)
bearBreak = not na(lastSL) and close < lastSL and (not requireBody or bearBodyBot < lastSL)
bearBosNow = false

if bearBreak and pendSlLive
    f_snap_pending(pendSlLn, true)
    pendSlLive := false

if bearBreak and not sBos and not sFibOn
    f_retire_struct(bBosLine)
    bBosLine := na
    bBos := false
    bFibOn := false
    bEntered := false
    bFibHi := na
    bFibLo := na
    bEq := na
    f_del_box(bIrl)
    f_del_box(bFvgBox)
    f_del_box(bObBox)
    f_del_lab(bFibLbl)
    bIrl := na
    bFvgBox := na
    bObBox := na
    bFibLbl := na

    sIsMss := lastBreakSide == 1
    lastBreakSide := -1
    sBos := true
    sBosBar := bar_index
    sLevel := lastSL
    sPriorSH := lastSH
    sFibOn := false
    sEntered := false
    sFibHi := na
    sFibLo := na
    sEq := na
    f_del_box(sIrl)
    f_del_box(sFvgBox)
    f_del_box(sObBox)
    f_del_lab(sFibLbl)
    sIrl := na
    sFvgBox := na
    sObBox := na
    sFibLbl := na
    f_retire_struct(sBosLine)
    f_del_lab(sSwingLbl)
    f_del_lab(sBreakLbl)
    if not na(pendSlLn)
        [sSw, sBr] = f_promote_struct(pendSlLn, lastSlBar, lastSL, bar_index, false, sIsMss)
        sBosLine := pendSlLn
        sSwingLbl := sSw
        sBreakLbl := sBr
        pendSlLn := na
    else
        [sLn, sSw, sBr] = f_new_struct_line(lastSlBar, lastSL, bar_index, false, sIsMss)
        sBosLine := sLn
        sSwingLbl := sSw
        sBreakLbl := sBr
    bearBosNow := true
else if bearBreak and not na(pendSlLn)
    line.set_color(pendSlLn, color.new(#d4543c, 55))
    line.set_style(pendSlLn, line.style_dotted)
    line.set_width(pendSlLn, 1)
    line.set_extend(pendSlLn, extend.none)
    line.set_x2(pendSlLn, bar_index)
    pendSlLn := na
    pendSlLive := false

bearFibNow = false

if fibMode == "Immediate on BOS" and bearBosNow
    fibLoImmS = math.min(low, sLevel)
    fibHiImmS = not na(sPriorSH) ? sPriorSH : lastSH
    if not na(fibHiImmS) and not na(fibLoImmS) and fibHiImmS > fibLoImmS
        sFibHi := fibHiImmS
        sFibLo := fibLoImmS
        sEq := sFibHi - (sFibHi - sFibLo) * 0.5
        sFibOn := true
        sFibBar := bar_index
        sEntered := false
        sBos := false
        f_retire_struct(sBosLine)
        sBosLine := na
        f_del_box(sIrl)
        f_del_lab(sFibLbl)
        sIrl := box.new(bar_index, sFibHi, bar_index + irlBars, sEq,
             bgcolor=color.new(#d4543c, 72), border_color=color.new(#f0c040, 0), border_width=3,
             border_style=line.style_dashed)
        sFibLbl := label.new(bar_index, sEq, "FIB ≥0.5 IRL",
             style=label.style_label_up, color=color.new(#f0c040, 0), textcolor=color.black, size=size.normal)
        bearFibNow := true

if sBos and not sFibOn and not na(pl)
    slBar = bar_index - swingLen
    if not na(sBosBar) and slBar > sBosBar
        fibHi = not na(lastSH) ? lastSH : sPriorSH
        if not na(fibHi) and fibHi > pl
            sFibHi := fibHi
            sFibLo := pl
            sEq := sFibHi - (sFibHi - sFibLo) * 0.5
            sFibOn := true
            sFibBar := bar_index
            sEntered := false
            sBos := false
            f_retire_struct(sBosLine)
            sBosLine := na
            f_del_box(sIrl)
            f_del_lab(sFibLbl)
            sIrl := box.new(bar_index - swingLen, sFibHi, bar_index + irlBars, sEq,
                 bgcolor=color.new(#d4543c, 72), border_color=color.new(#f0c040, 0), border_width=3,
                 border_style=line.style_dashed)
            sFibLbl := label.new(bar_index - swingLen, sEq, "FIB ≥0.5 IRL",
                 style=label.style_label_up, color=color.new(#f0c040, 0), textcolor=color.black, size=size.normal)
            bearFibNow := true

if sFibOn and fibMode == "Immediate on BOS" and not na(pl) and not na(sFibBar) and (bar_index - swingLen) > sFibBar and pl < sFibLo and not na(sFibHi) and sFibHi > pl
    sFibLo := pl
    sEq := sFibHi - (sFibHi - sFibLo) * 0.5
    if not na(sIrl)
        box.set_bottom(sIrl, sEq)
    if not na(sFibLbl)
        label.set_y(sFibLbl, sEq)
        label.set_x(sFibLbl, bar_index - swingLen)
// Grow pending rays only while still unbroken (never past MSS/BOS bar)
if pendShLive and not na(pendShLn)
    line.set_x2(pendShLn, bar_index)
    line.set_extend(pendShLn, extend.none)
if pendSlLive and not na(pendSlLn)
    line.set_x2(pendSlLn, bar_index)
    line.set_extend(pendSlLn, extend.none)

plot(bFibOn ? bEq : na, "Bull 0.5 (IRL)", color=color.new(#f0c040, 0), linewidth=3)
plot(sFibOn ? sEq : na, "Bear 0.5 (IRL)", color=color.new(#f0c040, 0), linewidth=3)
plot(showFibExtremes and bFibOn ? bFibHi : na, "Bull Fib 1", color=color.new(#3dba7e, 50), linewidth=1)
plot(showFibExtremes and bFibOn ? bFibLo : na, "Bull Fib 0", color=color.new(#3dba7e, 50), linewidth=1)
plot(showFibExtremes and sFibOn ? sFibHi : na, "Bear Fib 1", color=color.new(#d4543c, 50), linewidth=1)
plot(showFibExtremes and sFibOn ? sFibLo : na, "Bear Fib 0", color=color.new(#d4543c, 50), linewidth=1)

// ── Virgin FVG / OB (capped pools — avoids TV 40s timeout) ──
maxZones = maxZonesIn

var float[] bfTop = array.new_float()
var float[] bfBot = array.new_float()
var int[]   bfBar = array.new_int()
var bool[]  bfLive = array.new_bool()
var box[]   bfBox = array.new_box()

var float[] sfTop = array.new_float()
var float[] sfBot = array.new_float()
var int[]   sfBar = array.new_int()
var bool[]  sfLive = array.new_bool()
var box[]   sfBox = array.new_box()

var float[] boTop = array.new_float()
var float[] boBot = array.new_float()
var int[]   boBar = array.new_int()
var bool[]  boLive = array.new_bool()
var box[]   boBox = array.new_box()

var float[] soTop = array.new_float()
var float[] soBot = array.new_float()
var int[]   soBar = array.new_int()
var bool[]  soLive = array.new_bool()
var box[]   soBox = array.new_box()

f_shift_zone(tops, bots, bars, lives, boxes) =>
    bx0 = array.get(boxes, 0)
    if not na(bx0)
        box.delete(bx0)
    array.shift(tops)
    array.shift(bots)
    array.shift(bars)
    array.shift(lives)
    array.shift(boxes)

f_kill_zone(lives, boxes, idx) =>
    array.set(lives, idx, false)
    bx = array.get(boxes, idx)
    if not na(bx)
        box.set_bgcolor(bx, color.new(color.gray, 92))
        box.set_border_color(bx, color.new(color.gray, 75))
        box.set_right(bx, bar_index)

bullFvgNow = high[2] < low[0]
bearFvgNow = low[2] > high[0]

if useFvg and bullFvgNow and low[0] > high[2]
    if array.size(bfTop) >= maxZones
        f_shift_zone(bfTop, bfBot, bfBar, bfLive, bfBox)
    array.push(bfTop, low[0])
    array.push(bfBot, high[2])
    array.push(bfBar, bar_index)
    array.push(bfLive, true)
    array.push(bfBox, box.new(bar_index - 2, low[0], bar_index + 2, high[2], bgcolor=color.new(#3dba7e, 92), border_color=color.new(#3dba7e, 70), border_width=1, border_style=line.style_dotted))

if useFvg and bearFvgNow and low[2] > high[0]
    if array.size(sfTop) >= maxZones
        f_shift_zone(sfTop, sfBot, sfBar, sfLive, sfBox)
    array.push(sfTop, low[2])
    array.push(sfBot, high[0])
    array.push(sfBar, bar_index)
    array.push(sfLive, true)
    array.push(sfBox, box.new(bar_index - 2, low[2], bar_index + 2, high[0], bgcolor=color.new(#d4543c, 92), border_color=color.new(#d4543c, 70), border_width=1, border_style=line.style_dotted))

// Textbook OB: only on the displacement bar of the prior candle (O(1), no nested scan)
if useOb and close[1] < open[1] and close > high[1]
    if array.size(boTop) >= maxZones
        f_shift_zone(boTop, boBot, boBar, boLive, boBox)
    array.push(boTop, open[1])
    array.push(boBot, close[1])
    array.push(boBar, bar_index - 1)
    array.push(boLive, true)
    array.push(boBox, box.new(bar_index - 1, open[1], bar_index + 2, close[1], bgcolor=color.new(#8a7a50, 93), border_color=color.new(#8a7a50, 65), border_width=1, border_style=line.style_dotted))

if useOb and close[1] > open[1] and close < low[1]
    if array.size(soTop) >= maxZones
        f_shift_zone(soTop, soBot, soBar, soLive, soBox)
    array.push(soTop, close[1])
    array.push(soBot, open[1])
    array.push(soBar, bar_index - 1)
    array.push(soLive, true)
    array.push(soBox, box.new(bar_index - 1, close[1], bar_index + 2, open[1], bgcolor=color.new(#8a7a50, 93), border_color=color.new(#8a7a50, 65), border_width=1, border_style=line.style_dotted))

bullEntryNow = false
bearEntryNow = false
var int lastBullConf = 0
var int lastBearConf = 0
var int lastBullEntBar = na
var int lastBearEntBar = na
var int lastStopBar = na
var bool pendingUnlockL = false
var bool pendingUnlockS = false
var float lastSigSlL = na
var float lastSigSlS = na
var int entryBar = na
var float beEntry = na
var float beRisk = na
var bool beDone = false

// Detect flat after open: stop vs TP handling + post-stop ban
justClosed = strategy.position_size[1] != 0 and strategy.position_size == 0
if justClosed and strategy.closedtrades > 0
    idx = strategy.closedtrades - 1
    closedSz = strategy.closedtrades.size(idx)
    lost = strategy.closedtrades.profit(idx) <= 0
    if lost
        lastStopBar := bar_index
        if closedSz > 0
            bEntered := true
            if reenterSameFib and not lockFibOnStop
                pendingUnlockL := true
            else if reenterSameFib and lockFibOnStop
                pendingUnlockL := true
            else
                pendingUnlockL := false
        if closedSz < 0
            sEntered := true
            if reenterSameFib
                pendingUnlockS := true
            else
                pendingUnlockS := false
    else
        // TP / winner — optional same-Fib re-shot
        if reenterSameFib
            if closedSz > 0
                bEntered := false
            if closedSz < 0
                sEntered := false
    beDone := false
    beEntry := na
    beRisk := na
    entryBar := na

// Unlock same Fib only after post-stop ban
if pendingUnlockL and not na(lastStopBar) and bar_index - lastStopBar >= postStopCooldown and strategy.position_size == 0
    bEntered := false
    pendingUnlockL := false
if pendingUnlockS and not na(lastStopBar) and bar_index - lastStopBar >= postStopCooldown and strategy.position_size == 0
    sEntered := false
    pendingUnlockS := false

// Legacy: if Re-enter without lock and no pending unlock path, clear on flat winners already handled;
// do not blanket-clear on every flat (that caused stop→instant reentry).

fvgHit = false
obHit = false
fvgHitS = false
obHitS = false
hitBfIdx = -1
hitBoIdx = -1
hitSfIdx = -1
hitSoIdx = -1

biasOkL = biasFilter == "Off" or (biasFilter == "Block opposite" and biasDir != -1) or (biasFilter == "Aligned only" and biasDir == 1)
biasOkSMatch = biasFilter == "Off" or (biasFilter == "Block opposite" and biasDir != 1) or (biasFilter == "Aligned only" and biasDir == -1)
biasOkS = shortFilter == "Long only" ? false : shortFilter == "Aligned only" ? (biasDir == -1) : shortFilter == "No shorts on bull day" ? (biasDir != 1) : biasOkSMatch
coolStop = na(lastStopBar) or bar_index - lastStopBar >= postStopCooldown

if bFibOn and not na(bEq)
    inDisc = low <= bEq and high >= bFibLo
    deepL = close <= bFibLo + (bEq - bFibLo) * 0.5
    if useFvg
        sz = array.size(bfLive)
        if sz > 0
            for i = 0 to sz - 1
                if array.get(bfLive, i) and bar_index > array.get(bfBar, i)
                    t = array.get(bfTop, i)
                    b = array.get(bfBot, i)
                    if b < bEq and t > bFibLo and low <= t and high >= b
                        fvgHit := true
                        hitBfIdx := i
                        break
    if useOb
        sz = array.size(boLive)
        if sz > 0
            for i = 0 to sz - 1
                if array.get(boLive, i) and bar_index > array.get(boBar, i)
                    t = array.get(boTop, i)
                    b = array.get(boBot, i)
                    if b >= bFibLo and t <= bEq and low <= t and high >= b
                        obHit := true
                        hitBoIdx := i
                        break
    zoneCond = needEither ? (fvgHit or obHit) : (fvgHit and obHit)
    cond = entryMode == "Zone only" ? true : entryMode == "Zone + FVG/OB" ? zoneCond : (zoneCond or deepL)
    coolL = na(lastBullEntBar) or bar_index - lastBullEntBar >= entryCooldown
    flatOk = strategy.position_size == 0
    confLProbe = f_entry_conf(true, fvgHit, obHit)
    if inDisc and cond and close <= bEq and not bEntered and coolL and coolStop and flatOk and biasOkL and inDateWindow and confLProbe >= minConf
        bEntered := true
        bullEntryNow := true
        lastBullEntBar := bar_index
        confL = confLProbe
        lastBullConf := confL
        lastSigSlL := na
        if fvgHit and hitBfIdx >= 0
            lastSigSlL := array.get(bfBot, hitBfIdx)
        else if obHit and hitBoIdx >= 0
            lastSigSlL := array.get(boBot, hitBoIdx)
        f_push_ent(entLHist, label.new(bar_index, low, "ENT L · " + str.tostring(close, format.mintick) + "\n" + str.tostring(confL) + " " + f_conf_tag(confL),
             style=label.style_label_up, color=color.new(#3dba7e, 0), textcolor=color.white, size=size.small))
        if zoneCond and hitBfIdx >= 0
            f_kill_zone(bfLive, bfBox, hitBfIdx)
        if zoneCond and hitBoIdx >= 0
            f_kill_zone(boLive, boBox, hitBoIdx)

if sFibOn and not na(sEq)
    inPrem = high >= sEq and low <= sFibHi
    deepS = close >= sEq + (sFibHi - sEq) * 0.5
    if useFvg
        sz = array.size(sfLive)
        if sz > 0
            for i = 0 to sz - 1
                if array.get(sfLive, i) and bar_index > array.get(sfBar, i)
                    t = array.get(sfTop, i)
                    b = array.get(sfBot, i)
                    if t > sEq and b < sFibHi and high >= b and low <= t
                        fvgHitS := true
                        hitSfIdx := i
                        break
    if useOb
        sz = array.size(soLive)
        if sz > 0
            for i = 0 to sz - 1
                if array.get(soLive, i) and bar_index > array.get(soBar, i)
                    t = array.get(soTop, i)
                    b = array.get(soBot, i)
                    if b >= sEq and t <= sFibHi and high >= b and low <= t
                        obHitS := true
                        hitSoIdx := i
                        break
    zoneCondS = needEither ? (fvgHitS or obHitS) : (fvgHitS and obHitS)
    condS = entryMode == "Zone only" ? true : entryMode == "Zone + FVG/OB" ? zoneCondS : (zoneCondS or deepS)
    coolS = na(lastBearEntBar) or bar_index - lastBearEntBar >= entryCooldown
    flatOkS = strategy.position_size == 0
    confSProbe = f_entry_conf(false, fvgHitS, obHitS)
    if inPrem and condS and close >= sEq and not sEntered and coolS and coolStop and flatOkS and biasOkS and inDateWindow and confSProbe >= minConf
        sEntered := true
        bearEntryNow := true
        lastBearEntBar := bar_index
        confS = confSProbe
        lastBearConf := confS
        lastSigSlS := na
        if fvgHitS and hitSfIdx >= 0
            lastSigSlS := array.get(sfTop, hitSfIdx)
        else if obHitS and hitSoIdx >= 0
            lastSigSlS := array.get(soTop, hitSoIdx)
        f_push_ent(entSHist, label.new(bar_index, high, "ENT S · " + str.tostring(close, format.mintick) + "\n" + str.tostring(confS) + " " + f_conf_tag(confS),
             style=label.style_label_down, color=color.new(#d4543c, 0), textcolor=color.white, size=size.small))
        if zoneCondS and hitSfIdx >= 0
            f_kill_zone(sfLive, sfBox, hitSfIdx)
        if zoneCondS and hitSoIdx >= 0
            f_kill_zone(soLive, soBox, hitSoIdx)

// Maintain: expire / fill (extend boxes only on last bar — major speed win)
f_maintain(tops, bots, bars, lives, boxes, isBullGap) =>
    sz = array.size(lives)
    if sz > 0
        for i = 0 to sz - 1
            if array.get(lives, i)
                aged = bar_index - array.get(bars, i) > zoneKeep
                filled = isBullGap ? close < array.get(bots, i) : close > array.get(tops, i)
                if aged or filled
                    f_kill_zone(lives, boxes, i)
                else if barstate.islast
                    box.set_right(array.get(boxes, i), bar_index + 2)

f_maintain(bfTop, bfBot, bfBar, bfLive, bfBox, true)
f_maintain(sfTop, sfBot, sfBar, sfLive, sfBox, false)
f_maintain(boTop, boBot, boBar, boLive, boBox, true)
f_maintain(soTop, soBot, soBar, soLive, soBox, false)

plotshape(not cleanMode and bullFibNow, title="FIB L", style=shape.labelup, location=location.belowbar,
     color=color.new(#e8a838, 0), text="FIB", textcolor=color.black, size=size.small)
plotshape(not cleanMode and bullEntryNow, title="ENT L", style=shape.labelup, location=location.belowbar,
     color=color.new(#3dba7e, 0), text="ENT L", textcolor=color.white, size=size.normal)
plotshape(not cleanMode and bearFibNow, title="FIB S", style=shape.labeldown, location=location.abovebar,
     color=color.new(#e8a838, 0), text="FIB", textcolor=color.black, size=size.small)
plotshape(not cleanMode and bearEntryNow, title="ENT S", style=shape.labeldown, location=location.abovebar,
     color=color.new(#d4543c, 0), text="ENT S", textcolor=color.white, size=size.normal)

inBullIrl = bFibOn and not na(bEq) and close <= bEq and close >= bFibLo
inBearIrl = sFibOn and not na(sEq) and close >= sEq and close <= sFibHi
nowTxt = bullEntryNow ? "NOW · ENT L · " + str.tostring(close, format.mintick) + " · " + str.tostring(lastBullConf) : bearEntryNow ? "NOW · ENT S · " + str.tostring(close, format.mintick) + " · " + str.tostring(lastBearConf) : bFibOn ? (inBullIrl ? "NOW · IN ≤0.5\nwait virgin FVG/OB" : "NOW · FIB long\nwait ≤0.5") : sFibOn ? (inBearIrl ? "NOW · IN ≥0.5\nwait virgin FVG/OB" : "NOW · FIB short\nwait ≥0.5") : bBos ? "NOW · struct↑\nwait post-SH Fib" : sBos ? "NOW · struct↓\nwait post-SL Fib" : "NOW · FLAT"
nowTxt := nowTxt + "\n" + biasTxt

bgcolor(highlightNow and barstate.islast and bFibOn ? color.new(#3dba7e, inBullIrl ? 85 : 93) : na)
bgcolor(highlightNow and barstate.islast and sFibOn ? color.new(#d4543c, inBearIrl ? 85 : 93) : na)

if barstate.islast and highlightNow
    if not na(nowBadge)
        label.delete(nowBadge)
    nowBadge := label.new(bar_index + 1, close, nowTxt, style=label.style_label_left,
         color=bFibOn or bullEntryNow ? color.new(#3dba7e, 15) : sFibOn or bearEntryNow ? color.new(#d4543c, 15) : color.new(#161411, 10),
         textcolor=color.white, size=size.normal)

var table info = table.new(position.top_right, 2, 12, bgcolor=color.new(#0c0b0a, 5), border_width=1)
if barstate.islast
    nClosed = strategy.closedtrades
    nWin = strategy.wintrades
    gp = strategy.grossprofit
    gl = math.abs(strategy.grossloss)
    wrPct = nClosed > 0 ? 100.0 * nWin / nClosed : 0.0
    pfNow = gl > 0 ? gp / gl : nWin > 0 ? 99.0 : 0.0
    table.cell(info, 0, 0, "LEDGER", text_color=#e8a838, text_size=size.normal)
    table.cell(info, 1, 0, "0.8.8 " + presetTag, text_color=color.gray, text_size=size.small)
    st = bullEntryNow ? "ENTRY L" : bearEntryNow ? "ENTRY S" : bFibOn ? "FIB L" : sFibOn ? "FIB S" : bBos ? (bIsMss ? "MSS↑" : "BOS↑") : sBos ? (sIsMss ? "MSS↓" : "BOS↓") : "FLAT"
    table.cell(info, 0, 1, "NOW", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 1, st, text_color=color.white, text_size=size.normal)
    biasCol = biasDir == 1 ? color.new(#3dba7e, 0) : biasDir == -1 ? color.new(#d4543c, 0) : color.new(#e8a838, 0)
    table.cell(info, 0, 2, "BIAS", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 2, biasTxt, text_color=biasCol, text_size=size.tiny)
    table.cell(info, 0, 3, "Score", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 3, str.tostring(nClosed) + "t WR " + str.tostring(wrPct, "#.#") + "% PF " + str.tostring(pfNow, "#.###"), text_color=color.white, text_size=size.tiny)
    table.cell(info, 0, 4, "0.5", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 4, bFibOn ? str.tostring(bEq, format.mintick) : sFibOn ? str.tostring(sEq, format.mintick) : "—", text_color=#e8a838, text_size=size.small)
    table.cell(info, 0, 5, "Swing", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 5, str.tostring(swingLen) + " / " + str.tostring(minSwingAtr, "#.#") + "ATR", text_color=color.white, text_size=size.tiny)
    table.cell(info, 0, 6, "Preset", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 6, presetTag + " · R" + str.tostring(rrMult, "#.#") + " · " + entryMode, text_color=color.white, text_size=size.tiny)
    table.cell(info, 0, 7, "ShortFlt", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 7, shortFilter, text_color=color.white, text_size=size.tiny)
    table.cell(info, 0, 8, "Cool/Stop", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 8, str.tostring(entryCooldown) + " / post " + str.tostring(postStopCooldown) + (useBe ? " · BE@" + str.tostring(beTriggerR, "#.#") + "R" : ""), text_color=color.white, text_size=size.tiny)
    table.cell(info, 0, 9, "SL", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 9, (slMode == "Fixed USD" ? "USD " + str.tostring(fixedDollarSl, "#") : slMode) + (minHoldBars > 0 ? " · hold" + str.tostring(minHoldBars) : "") + (maxHoldBars > 0 ? " · max" + str.tostring(maxHoldBars) : "") + (exitOppStruct ? " · oppX" : ""), text_color=color.white, text_size=size.tiny)
    table.cell(info, 0, 10, "Fib", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 10, fibMode, text_color=color.white, text_size=size.tiny)
    table.cell(info, 0, 11, "Win", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 11, useDateWindow ? "DATE LTD" : "FULL", text_color=useDateWindow ? #e8a838 : color.gray, text_size=size.tiny)

sym = symbolOverride == "" ? syminfo.ticker : symbolOverride

if alertOnBos and bullBosNow
    alert('{"secret":"' + alertSecret + '","stage":"SETUP_ARMED","symbol":"' + sym + '","side":"long","timeframe":"' + timeframe.period + '","price":' + str.tostring(close) + ',"bias":"' + biasTxt + '","message":"Structure↑ confirm — wait post-SH Fib then ≤0.5 FVG/OB"}', alert.freq_once_per_bar_close)
if alertOnBos and bearBosNow
    alert('{"secret":"' + alertSecret + '","stage":"SETUP_ARMED","symbol":"' + sym + '","side":"short","timeframe":"' + timeframe.period + '","price":' + str.tostring(close) + ',"bias":"' + biasTxt + '","message":"Structure↓ confirm — wait post-SL Fib then ≥0.5 FVG/OB"}', alert.freq_once_per_bar_close)

if bullFibNow
    alert('{"secret":"' + alertSecret + '","stage":"SETUP_ARMED","symbol":"' + sym + '","side":"long","timeframe":"' + timeframe.period + '","price":' + str.tostring(close) + ',"bias":"' + biasTxt + '","message":"Fib ready — wait ≤0.5 with 1H FVG/OB"}', alert.freq_once_per_bar_close)
if bearFibNow
    alert('{"secret":"' + alertSecret + '","stage":"SETUP_ARMED","symbol":"' + sym + '","side":"short","timeframe":"' + timeframe.period + '","price":' + str.tostring(close) + ',"bias":"' + biasTxt + '","message":"Fib ready — wait ≥0.5 with 1H FVG/OB"}', alert.freq_once_per_bar_close)

if bullEntryNow
    alert('{"secret":"' + alertSecret + '","stage":"ENTRY_READY","symbol":"' + sym + '","side":"long","timeframe":"' + timeframe.period + '","price":' + str.tostring(close) + ',"confidence":' + str.tostring(lastBullConf) + ',"bias":"' + biasTxt + '","message":"1H ENTRY L conf=' + str.tostring(lastBullConf) + '"}', alert.freq_once_per_bar_close)
if bearEntryNow
    alert('{"secret":"' + alertSecret + '","stage":"ENTRY_READY","symbol":"' + sym + '","side":"short","timeframe":"' + timeframe.period + '","price":' + str.tostring(close) + ',"confidence":' + str.tostring(lastBearConf) + ',"bias":"' + biasTxt + '","message":"1H ENTRY S conf=' + str.tostring(lastBearConf) + '"}', alert.freq_once_per_bar_close)

// ── Strategy fills: risk-% size, Fib SL + single R TP + BE / min-hold ──
var float pendSl = na
var float pendTp = na
var float pendSlHard = na

f_qty_for_risk(entryPx, slPx) =>
    riskCash = strategy.equity * riskPct / 100.0
    dist = math.abs(entryPx - slPx)
    q = dist > syminfo.mintick ? riskCash / dist : 0.0
    maxQ = strategy.equity > 0 and entryPx > 0 ? strategy.equity * 0.5 / entryPx : q
    q > 0 ? math.min(q, maxQ) : na

slArmedL = strategy.position_size > 0 and (minHoldBars <= 0 or (not na(entryBar) and bar_index - entryBar >= minHoldBars))
slArmedS = strategy.position_size < 0 and (minHoldBars <= 0 or (not na(entryBar) and bar_index - entryBar >= minHoldBars))

if bullEntryNow
    atrSl = close - atr * fallbackAtrSl
    fibSl = not na(bFibLo) and bFibLo < close ? bFibLo : atrSl
    zoneSl = not na(lastSigSlL) and lastSigSlL < close ? lastSigSlL : fibSl
    usdSl = close - fixedDollarSl
    slL = slMode == "ATR × fallback" ? atrSl : slMode == "Signal zone" ? zoneSl : slMode == "Fixed USD" ? usdSl : fibSl
    riskL = close - slL
    qtyL = f_qty_for_risk(close, slL)
    if riskL > syminfo.mintick and not na(qtyL) and qtyL > 0
        pendSlHard := slL
        pendSl := slL
        pendTp := close + riskL * rrMult
        beEntry := close
        beRisk := riskL
        beDone := false
        entryBar := bar_index
        strategy.cancel("XS")
        strategy.cancel("XS1")
        strategy.cancel("XS2")
        strategy.close("S", comment="flip")
        strategy.entry("L", strategy.long, qty=qtyL)
        if minHoldBars <= 0
            strategy.exit("XL", from_entry="L", stop=pendSl, limit=pendTp)
        else
            strategy.exit("XL", from_entry="L", limit=pendTp)

if bearEntryNow
    atrSlS = close + atr * fallbackAtrSl
    fibSlS = not na(sFibHi) and sFibHi > close ? sFibHi : atrSlS
    zoneSlS = not na(lastSigSlS) and lastSigSlS > close ? lastSigSlS : fibSlS
    usdSlS = close + fixedDollarSl
    slS = slMode == "ATR × fallback" ? atrSlS : slMode == "Signal zone" ? zoneSlS : slMode == "Fixed USD" ? usdSlS : fibSlS
    riskS = slS - close
    qtyS = f_qty_for_risk(close, slS)
    if riskS > syminfo.mintick and not na(qtyS) and qtyS > 0
        pendSlHard := slS
        pendSl := slS
        pendTp := close - riskS * rrMult
        beEntry := close
        beRisk := riskS
        beDone := false
        entryBar := bar_index
        strategy.cancel("XL")
        strategy.cancel("XL1")
        strategy.cancel("XL2")
        strategy.close("L", comment="flip")
        strategy.entry("S", strategy.short, qty=qtyS)
        if minHoldBars <= 0
            strategy.exit("XS", from_entry="S", stop=pendSl, limit=pendTp)
        else
            strategy.exit("XS", from_entry="S", limit=pendTp)

// BE: once MFE ≥ trigger R, ratchet stop to entry
if useBe and not beDone and not na(beEntry) and not na(beRisk) and beRisk > 0
    if strategy.position_size > 0
        mfeR = (high - beEntry) / beRisk
        if mfeR >= beTriggerR
            pendSl := math.max(beEntry, pendSl)
            beDone := true
    else if strategy.position_size < 0
        mfeR = (beEntry - low) / beRisk
        if mfeR >= beTriggerR
            pendSl := math.min(beEntry, pendSl)
            beDone := true

// Max-hold / opposite structure flat (before bracket refresh)
holdBarsNow = not na(entryBar) ? bar_index - entryBar : 0
if strategy.position_size > 0 and not bullEntryNow
    if exitOppStruct and bearBosNow
        strategy.cancel("XL")
        strategy.close("L", comment="opp↓")
    else if maxHoldBars > 0 and holdBarsNow >= maxHoldBars
        strategy.cancel("XL")
        strategy.close("L", comment="maxHold")
if strategy.position_size < 0 and not bearEntryNow
    if exitOppStruct and bullBosNow
        strategy.cancel("XS")
        strategy.close("S", comment="opp↑")
    else if maxHoldBars > 0 and holdBarsNow >= maxHoldBars
        strategy.cancel("XS")
        strategy.close("S", comment="maxHold")

// Refresh exits while in trade (min-hold arm + BE updates)
if strategy.position_size > 0 and not bullEntryNow and not na(pendTp)
    if slArmedL or beDone
        strategy.exit("XL", from_entry="L", stop=pendSl, limit=pendTp)
    else
        strategy.exit("XL", from_entry="L", limit=pendTp)
if strategy.position_size < 0 and not bearEntryNow and not na(pendTp)
    if slArmedS or beDone
        strategy.exit("XS", from_entry="S", stop=pendSl, limit=pendTp)
    else
        strategy.exit("XS", from_entry="S", limit=pendTp)

plot(strategy.position_size > 0 ? pendSl : na, "Long SL", color=color.new(#d4543c, 0), style=plot.style_linebr, linewidth=1)
plot(strategy.position_size > 0 ? pendTp : na, "Long TP", color=color.new(#3dba7e, 0), style=plot.style_linebr, linewidth=1)
plot(strategy.position_size < 0 ? pendSl : na, "Short SL", color=color.new(#d4543c, 0), style=plot.style_linebr, linewidth=1)
plot(strategy.position_size < 0 ? pendTp : na, "Short TP", color=color.new(#3dba7e, 0), style=plot.style_linebr, linewidth=1)
