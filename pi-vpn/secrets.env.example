# Local secrets for Pi VPN scripts — DO NOT COMMIT
# Copy to secrets.env and fill token on the Pi only:
#   cp secrets.env.example secrets.env && nano secrets.env

DUCKDNS_DOMAIN=max-trading
DUCKDNS_TOKEN=
VPN_PORT=51820
VLESS_PORT=443
# Reality camouflage target (HTTPS site your network can reach)
REALITY_DEST=www.microsoft.com:443
REALITY_SERVER_NAMES=www.microsoft.com,microsoft.com
